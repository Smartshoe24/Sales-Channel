# Copy this file to .env and fill only the connections you use.

# Shopify — your store's myshopify.com address, e.g. stepwhere.myshopify.com
SHOPIFY_STORE=

# Apps made in the Shopify Dev Dashboard (all new apps since 1 Jan 2026):
# copy these two from the app's Settings page. The server swaps them for a
# 24-hour access token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Only for an old app created in Shopify admin before 2026 that shows an
# Admin API access token (starts with shpat_). Leave empty otherwise.
SHOPIFY_ACCESS_TOKEN=

SHOPIFY_API_VERSION=2026-07

# Amazon India Selling Partner API
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# How many days of past orders the very first sync fetches (1–365, default 30).
# Later syncs only fetch orders changed since the previous sync.
# Note: Shopify's read_orders scope only returns the last 60 days.
SYNC_LOOKBACK_DAYS=30

# Optional: port for the local app (default 8080)
# PORT=8080
