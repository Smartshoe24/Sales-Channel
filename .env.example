# Copy this file to .env and fill only the connections you use.

# Shopify — example: stepwhere.myshopify.com
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Amazon India Selling Partner API
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# How many days of past orders the very first sync fetches (1–365, default 30).
# Later syncs only fetch orders changed since the previous sync.
# Note: Shopify's read_orders scope only returns the last 60 days.
SYNC_LOOKBACK_DAYS=30

# Optional: port for the local app (default 8080)
# PORT=8080
